# O projeto já está preparado para o board informado.
TRELLO_MODE=trello
TRELLO_BOARD_ID=KaACdOVE

# Cole as credenciais SOMENTE no seu .env.local.
# Não envie .env.local ao Git/GitHub/Vercel como arquivo.
TRELLO_API_KEY=
TRELLO_TOKEN=

# Opcional. Deixe vazio enquanto o dashboard estiver somente leitura.
# Para permitir escrita pelo drawer, configure uma senha longa e exclusiva.
DASHBOARD_WRITE_SECRET=

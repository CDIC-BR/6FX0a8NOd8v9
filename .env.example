# TRELLO_MODE é opcional. "trello" força a intenção de usar a API.
# Se for omitido, o app também tenta o Trello quando chave e token existem.
TRELLO_MODE=trello
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=KaACdOVE

# false enquanto a homologação completa ainda não puder ser mensurada.
HOMOLOGACAO_COMPLETA_ENABLED=false

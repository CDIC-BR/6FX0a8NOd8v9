# Deixe TRELLO_MODE=mock enquanto quiser testar sem credenciais.
TRELLO_MODE=mock

# Preencha para usar seu board real:
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# Opcional: proteção simples para habilitar escrita pelo dashboard.
# Se vazio, o dashboard continua somente leitura quando conectado ao Trello.
DASHBOARD_WRITE_SECRET=
